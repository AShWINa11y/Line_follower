// --- Pin Definitions for ESP32 30-Pin DevKit V1 ---
// Motor Driver (L298N) - Mapped to the RIGHT header, avoiding strapping pins
const int ENA = 23; // Left Motor Speed 
const int IN1 = 22; // Left Motor Fwd
const int IN2 = 21; // Left Motor Rev
const int IN3 = 19; // Right Motor Fwd
const int IN4 = 18; // Right Motor Rev
const int ENB = 17; // Right Motor Speed

// IR Sensors (Powered via 3.3V) - Mapped to the LEFT header (Input Only Pins)
const int SENSOR_LEFT = 34;
const int SENSOR_CENTER = 35;
const int SENSOR_RIGHT = 32; 

#define IS_BLACK(pin) (digitalRead(pin) == LOW)

// --- Robot State ---
