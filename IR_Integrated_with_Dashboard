// CHANGED: Most standard IR sensors output HIGH when on BLACK tape, and LOW on WHITE floor.
// If your robot still turns AWAY from the line, change this back to '== LOW'
#define IS_BLACK(pin) (digitalRead(pin) == HIGH)

