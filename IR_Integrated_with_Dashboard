// --- Motor Control Helper Functions ---
void setMotors(int leftSpeed, int rightSpeed) {
    // Left Motor Direction
    if (leftSpeed >= 0) {
        digitalWrite(IN1, HIGH);
        digitalWrite(IN2, LOW);
    } else {
        digitalWrite(IN1, LOW);
        digitalWrite(IN2, HIGH);
        leftSpeed = -leftSpeed; // Make positive for PWM
    }

    // Right Motor Direction
    if (rightSpeed >= 0) {
        digitalWrite(IN3, HIGH);
        digitalWrite(IN4, LOW);
    } else {
        digitalWrite(IN3, LOW);
        digitalWrite(IN4, HIGH);
        rightSpeed = -rightSpeed; // Make positive for PWM
    }

    // Update global state for telemetry
    leftPWM = constrain(leftSpeed, 0, 255);
    rightPWM = constrain(rightSpeed, 0, 255);

    // Apply PWM
    ledcWrite(ENA, leftPWM);
    ledcWrite(ENB, rightPWM);
}

void stopMotors() {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    leftPWM = 0;
    rightPWM = 0;
    ledcWrite(ENA, 0);
    ledcWrite(ENB, 0);
}

// --- Web Server Endpoints ---
void handleRoot() {
    server.send(200, "text/html", INDEX_HTML);
    Serial.println("[SERVER] Web interface requested by client.");
}

void handleCommand() {
    if (server.hasArg("action")) {
        String action = server.arg("action");
        if (action == "start") {
            if (currentMode == MODE_STOPPED) {
                currentMode = MODE_CLOSED_LOOP; 
            }
            server.send(200, "text/plain", "Started");
        } else if (action == "stop") {
            currentMode = MODE_STOPPED;
            stopMotors();
            server.send(200, "text/plain", "Stopped");
        } else if (action == "open_loop") {
            currentMode = MODE_OPEN_LOOP;
            server.send(200, "text/plain", "Mode: Open Loop");
        } else if (action == "closed_loop") {
            currentMode = MODE_CLOSED_LOOP;
            server.send(200, "text/plain", "Mode: Closed Loop");
        }
    } else {
        server.send(400, "text/plain", "Bad Request");
    }
}

void handleSpeed() {
    if (server.hasArg("val")) {
        int newSpeed = server.arg("val").toInt();
        
        // Update variables dynamically based on slider
        baseSpeed = constrain(newSpeed, 0, 255);
        softTurnSpeed = baseSpeed * 0.40; // 40% of base speed for inner wheel on soft turns
        hardTurnSpeed = baseSpeed * 0.85; // 85% of base speed for outer wheel on hard turns

        Serial.print("[COMMAND] Master Speed updated to: ");
        Serial.print(baseSpeed);
        Serial.print(" (Soft Turn: ");
        Serial.print(softTurnSpeed);
        Serial.print(", Hard Turn: ");
        Serial.print(hardTurnSpeed);
        Serial.println(")");
        
        server.send(200, "text/plain", "Speed Updated Successfully");
    } else {
        server.send(400, "text/plain", "Missing val argument");
    }
}

void handleData() {
    String json = "{";
    json += "\"leftPWM\":" + String(leftPWM) + ",";
    json += "\"rightPWM\":" + String(rightPWM) + ",";
    json += "\"sL\":" + String(leftState) + ",";
    json += "\"sC\":" + String(centerState) + ",";
    json += "\"sR\":" + String(rightState);
    json += "}";
    server.send(200, "application/json", json);
}

void setup() {
    Serial.begin(115200);
    delay(1000); 
    
    Serial.println("\n\n=======================================");
    Serial.println("   ESP32 (30-PIN) Line Follower Init    ");
    Serial.println("=======================================");

    Serial.println("[SYSTEM] Initializing Motor Control Pins (Right Header)...");
    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);
    
    Serial.println("[SYSTEM] Setting up PWM generation...");
    ledcAttach(ENA, freq, resolution);
    ledcAttach(ENB, freq, resolution);
    
    Serial.println("[SYSTEM] Initializing IR Sensor Array (Left Header)...");
    pinMode(SENSOR_LEFT, INPUT);
    pinMode(SENSOR_CENTER, INPUT);
    pinMode(SENSOR_RIGHT, INPUT);
    
    stopMotors();
    Serial.println("[SYSTEM] Hardware successfully initialized. Motors are stopped.");

    // Dynamic variable setup on boot
    softTurnSpeed = baseSpeed * 0.40; 
    hardTurnSpeed = baseSpeed * 0.85;

    // WiFi Setup
    Serial.println("---------------------------------------");
    Serial.print("[WIFI] Attempting to connect to SSID: ");
    Serial.println(ssid);
    
    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid, password);
    
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
        delay(500);
        Serial.print(".");
        attempts++;
    }
    Serial.println();
    
    if(WiFi.status() == WL_CONNECTED) {
        Serial.println("[WIFI] >>> SUCCESSFULLY CONNECTED! <<<");
        Serial.print("[WIFI] Device IP Address : ");
        Serial.println(WiFi.localIP());
        Serial.print("[WIFI] Signal Strength   : ");
        Serial.print(WiFi.RSSI());
        Serial.println(" dBm");
    } else {
        Serial.println("[ERROR] >>> WIFI CONNECTION FAILED! <<<");
    }

    // WebServer Start
    Serial.println("---------------------------------------");
    Serial.println("[SERVER] Booting HTTP Server endpoints...");
    server.on("/", handleRoot);
    server.on("/cmd", handleCommand);
    server.on("/speed", handleSpeed); // NEW SPEED ENDPOINT
    server.on("/data", handleData);
    server.begin();
    Serial.println("[SERVER] HTTP server is online and listening.");
    Serial.println("=======================================\n");
}

void loop() {
    server.handleClient(); 
    
    if (currentMode != lastMode) {
        Serial.print("[STATE_CHANGE] Mode switched to: ");
        if (currentMode == MODE_STOPPED) Serial.println("STOPPED (Brakes Applied)");
        else if (currentMode == MODE_OPEN_LOOP) Serial.println("OPEN LOOP (Manual Straight)");
        else if (currentMode == MODE_CLOSED_LOOP) Serial.println("CLOSED LOOP (Line Tracking)");
        lastMode = currentMode;
    }

    // Read Sensors
    leftState = IS_BLACK(SENSOR_LEFT);
    centerState = IS_BLACK(SENSOR_CENTER);
    rightState = IS_BLACK(SENSOR_RIGHT);

    if (currentMode == MODE_STOPPED) {
        stopMotors();
    } 
    else if (currentMode == MODE_OPEN_LOOP) {
        // Open Loop: Ignore sensors, drive straight based on slider speed
        int openLoopSpeed = max(baseSpeed - 30, 0); // ensure it doesn't go negative
        setMotors(openLoopSpeed, openLoopSpeed); 
    }
    else if (currentMode == MODE_CLOSED_LOOP) {
        
        // Reverse speed calculation for sharp turns. Dynamically scales with master speed.
        int reverseSpeed = - (baseSpeed / 3); 

        if (centerState) {
            // STATE 1: Straight (Center sees line)
            setMotors(baseSpeed, baseSpeed);
        }
        else if (leftState && !centerState) {
            // Hard Turn Left
            setMotors(reverseSpeed, hardTurnSpeed);
        }
        else if (rightState && !centerState) {
            // Hard Turn Right
            setMotors(hardTurnSpeed, reverseSpeed);
        }
        else if (leftState && centerState) {
            // Soft Turn Left 
            setMotors(softTurnSpeed, baseSpeed);
        }
        else if (rightState && centerState) {
            // Soft Turn Right
            setMotors(baseSpeed, softTurnSpeed);
        }
        else {
            stopMotors(); 
        }
    }
    
    delay(10); 
}
