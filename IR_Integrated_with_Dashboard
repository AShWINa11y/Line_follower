// --- Motor Control Helper Functions ---

void kickstartMotors() {
    Serial.println("[SYSTEM] KICKSTART ENGAGED: Breaking static friction...");
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
    ledcWrite(ENA, 255);
    ledcWrite(ENB, 255);
    delay(60); 
}

void setMotors(int leftSpeed, int rightSpeed) {
    // APPLY BIAS: This automatically handles the fact that the right motor is physically stronger
    leftSpeed = (int)(leftSpeed * leftMotorBias);
    rightSpeed = (int)(rightSpeed * rightMotorBias);

    // Left Motor Direction
    if (leftSpeed >= 0) {
        digitalWrite(IN1, HIGH);
        digitalWrite(IN2, LOW);
    } else {
        digitalWrite(IN1, LOW);
        digitalWrite(IN2, HIGH);
        leftSpeed = -leftSpeed; 
    }

    // Right Motor Direction
    if (rightSpeed >= 0) {
        digitalWrite(IN3, HIGH);
        digitalWrite(IN4, LOW);
    } else {
        digitalWrite(IN3, LOW);
        digitalWrite(IN4, HIGH);
        rightSpeed = -rightSpeed; 
    }

    // Update telemetry state
    leftPWM = constrain(leftSpeed, 0, 255);
    rightPWM = constrain(rightSpeed, 0, 255);

    // Write to hardware
    ledcWrite(ENA, leftPWM);
    ledcWrite(ENB, rightPWM);
}

void stopMotors() {
    digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
    leftPWM = 0; rightPWM = 0;
    ledcWrite(ENA, 0); ledcWrite(ENB, 0);
}

// --- Web Server Endpoints ---
void handleRoot() { server.send(200, "text/html", INDEX_HTML); }

void handleCommand() {
    if (server.hasArg("action")) {
        String action = server.arg("action");
        if (action == "start") {
            if (currentMode == MODE_STOPPED) currentMode = MODE_CLOSED_LOOP; 
            server.send(200, "text/plain", "Started");
        } else if (action == "stop") {
            currentMode = MODE_STOPPED;
            server.send(200, "text/plain", "Stopped");
        } else if (action == "open_loop") {
            currentMode = MODE_OPEN_LOOP;
            server.send(200, "text/plain", "Mode: Open Loop");
        } else if (action == "closed_loop") {
            currentMode = MODE_CLOSED_LOOP;
            server.send(200, "text/plain", "Mode: Closed Loop");
        }
    } else { server.send(400, "text/plain", "Bad Request"); }
}

void handleSpeed() {
    if (server.hasArg("val")) {
        baseSpeed = constrain(server.arg("val").toInt(), 0, 255);
        Serial.print("[COMMAND] Master Speed updated to: ");
        Serial.println(baseSpeed);
        server.send(200, "text/plain", "Speed Updated");
    } else { server.send(400, "text/plain", "Missing val"); }
}

void handleData() {
    String json = "{\"leftPWM\":" + String(leftPWM) + ",\"rightPWM\":" + String(rightPWM) + 
                  ",\"sL\":" + String(leftState) + ",\"sC\":" + String(centerState) + ",\"sR\":" + String(rightState) + "}";
    server.send(200, "application/json", json);
}

void setup() {
    Serial.begin(115200);
    delay(1000); 
    Serial.println("\n=======================================");
    Serial.println("   ESP32 Proportional Line Follower     ");
    Serial.println("=======================================");

    pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT); pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);
    ledcAttach(ENA, freq, resolution); ledcAttach(ENB, freq, resolution);
    
    pinMode(SENSOR_LEFT, INPUT); pinMode(SENSOR_CENTER, INPUT); pinMode(SENSOR_RIGHT, INPUT);
    
    stopMotors();

    // WiFi Setup
    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid, password);
    Serial.print("[WIFI] Connecting");
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) { delay(500); Serial.print("."); attempts++; }
    Serial.println();
    
    if(WiFi.status() == WL_CONNECTED) {
        Serial.print("[WIFI] IP Address : ");
        Serial.println(WiFi.localIP());
    } else {
        Serial.println("[ERROR] WIFI CONNECTION FAILED!");
    }

    server.on("/", handleRoot);
    server.on("/cmd", handleCommand);
    server.on("/speed", handleSpeed); 
    server.on("/data", handleData);
    server.begin();
    Serial.println("[SERVER] Ready.");
}

void loop() {
    server.handleClient(); 
    
    if (currentMode != lastMode) {
        if (lastMode == MODE_STOPPED && (currentMode == MODE_OPEN_LOOP || currentMode == MODE_CLOSED_LOOP)) {
            kickstartMotors();
        }
        Serial.print("[STATE_CHANGE] Mode switched to: ");
        if (currentMode == MODE_STOPPED) Serial.println("STOPPED");
        else if (currentMode == MODE_OPEN_LOOP) Serial.println("OPEN LOOP");
        else if (currentMode == MODE_CLOSED_LOOP) Serial.println("CLOSED LOOP");
        
        lastMode = currentMode;
    }

    // Read Sensors
    leftState = IS_BLACK(SENSOR_LEFT);
    centerState = IS_BLACK(SENSOR_CENTER);
    rightState = IS_BLACK(SENSOR_RIGHT);

    if (currentMode == MODE_STOPPED) {
        stopMotors();
    } 
    else if (currentMode == MODE_OPEN_LOOP) {
        setMotors(baseSpeed, baseSpeed); 
    }
    else if (currentMode == MODE_CLOSED_LOOP) {
        
        int error = 0;
        
        if (centerState && !leftState && !rightState) {
            error = 0;   // Centered - Perfect
        }
        else if (leftState && centerState && !rightState) {
            error = -1;  // Slightly right, small left correction
        }
        else if (leftState && !centerState && !rightState) {
            error = -2;  // Drifting right, big left correction
        }
        else if (rightState && centerState && !leftState) {
            error = 1;   // Slightly left, small right correction
        }
        else if (rightState && !centerState && !leftState) {
            error = 2;   // Drifting left, big right correction
        }
        else if (!leftState && !centerState && !rightState) {
            // LOST LINE: Default to moving straight forward at base speed
            // This prevents the robot from stopping or violently spinning when it hits a gap in the tape
            error = 0; 
        }

        // Apply Proportional math
        int correction = error * Kp;
        
        int leftMotorSpeed = baseSpeed + correction;
        int rightMotorSpeed = baseSpeed - correction;

        setMotors(leftMotorSpeed, rightMotorSpeed);
    }
    
    delay(10); 
}
